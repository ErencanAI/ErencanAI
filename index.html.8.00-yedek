<!DOCTYPE html>

<html lang="tr">
<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
>

<title>ErencanAI 8.00</title>

<link rel="stylesheet" href="/style.css">

<!-- =====================================================
     MOBİL ARAÇ BUTONLARI
     ===================================================== -->

<style>

    /*
     * MOBİLDE ARAŞTIR / HAVA DURUMU / HAFIZA
     * BUTONLARININ GÖRÜNMESİNİ GARANTİLE
     */

    @media (max-width: 800px) {

        .composer-wrapper {
            position: absolute !important;
            left: 0;
            right: 0;
            bottom: 70px !important;
            padding: 10px 12px 9px !important;
            z-index: 20;
        }

        .composer {
            position: relative;
            width: 100%;
        }

        .composer-tools {
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            justify-content: flex-start !important;
            gap: 8px !important;
            width: 100% !important;
            height: auto !important;
            min-height: 46px;

            /* TUŞLARI BİRAZ YUKARI AL */
            margin-top: -3px !important;

            padding: 0 4px 8px !important;
            overflow: visible !important;
        }

        .tool-group {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            align-items: stretch !important;
            gap: 6px !important;
            width: 100% !important;
            min-width: 0;
            overflow: visible !important;
        }

        .quick-tool-static {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;

            flex: 1 1 0 !important;

            width: auto !important;
            min-width: 0 !important;
            min-height: 40px !important;

            padding: 8px 7px !important;

            color: var(--muted) !important;
            background: var(--panel-2) !important;

            border: 1px solid var(--border) !important;
            border-radius: 9px !important;

            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;

            font-size: 10px !important;
            line-height: 1 !important;

            visibility: visible !important;
            opacity: 1 !important;
        }

        .quick-tool-static:hover,
        .quick-tool-static:active {
            background: var(--panel-3) !important;
            color: var(--text) !important;
        }

        .composer-info {
            display: none !important;
        }

        .footer-warning {
            display: none !important;
        }

        #researchToolButton,
        #weatherToolButton,
        #memoryToolButton {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

    }


    /*
     * DAHA DAR TELEFONLAR
     */

    @media (max-width: 500px) {

        .composer-wrapper {
            padding:
                8px 8px 7px !important;
        }

        .composer-tools {
            padding:
                0 2px 7px !important;

            /* DAR EKRANDA DA BİRAZ YUKARIDA */
            margin-top: -3px !important;
        }

        .tool-group {
            gap: 4px !important;
        }

        .quick-tool-static {
            min-height: 38px !important;
            padding:
                7px 4px !important;
            font-size: 9px !important;
        }

    }


    /*
     * ÇOK DAR EKRANLAR
     */

    @media (max-width: 360px) {

        .quick-tool-static {
            font-size: 8px !important;
            padding:
                7px 2px !important;
        }

    }

</style>

</head>

<body>

<div class="app">

<!-- =====================================================
     SIDEBAR
     ===================================================== -->

<aside
    class="sidebar"
    id="sidebar"
>

    <div class="brand">

        <div class="brand-logo">
            E
        </div>

        <div>

            <div class="brand-name">
                ErencanAI
            </div>

            <div class="brand-version">
                8.00 PRO
            </div>

        </div>

    </div>


    <!-- PRO DURUMU -->

    <div class="pro-status-card">

        <div class="pro-status-icon">
            ★
        </div>

        <div>

            <strong>
                ErencanAI Pro
            </strong>

            <small>
                Gelişmiş yapay zeka
            </small>

        </div>

        <span class="pro-active-badge">
            AKTİF
        </span>

    </div>


    <!-- YENİ SOHBET -->

    <button
        class="new-chat-button"
        id="newChatButton"
        type="button"
    >

        <span>
            ＋
        </span>

        Yeni Sohbet

    </button>


    <!-- GEÇMİŞ -->

    <div class="sidebar-section-title">
        SOHBET GEÇMİŞİ
    </div>

    <div
        class="chat-history"
        id="chatHistory"
    ></div>


    <!-- ALT BUTONLAR -->

    <div class="sidebar-bottom">

        <button
            class="sidebar-button"
            id="clearChatButton"
            type="button"
        >

            🗑️

            <span>
                Bu Sohbeti Temizle
            </span>

        </button>


        <button
            class="sidebar-button"
            id="searchButton"
            type="button"
        >

            🔎

            <span>
                Sohbetlerde Ara
            </span>

        </button>


        <button
            class="sidebar-button"
            id="settingsButton"
            type="button"
        >

            ⚙️

            <span>
                Ayarlar
            </span>

        </button>


        <button
            class="account-card"
            id="accountButton"
            type="button"
        >

            <div class="account-avatar">
                E
            </div>

            <div class="account-info">

                <strong>
                    Erencan
                </strong>

                <small>
                    Pro hesap
                </small>

            </div>

        </button>

    </div>

</aside>


<!-- =====================================================
     ANA ALAN
     ===================================================== -->

<main class="main">


    <!-- TOPBAR -->

    <header class="topbar">

        <div class="topbar-left">

            <button
                class="icon-button mobile-menu"
                id="menuButton"
                type="button"
                aria-label="Menü"
            >
                ☰
            </button>


            <div class="model-selector">

                <div class="model-icon">
                    E
                </div>

                <div>

                    <div class="model-title">
                        ErencanAI
                    </div>

                    <div class="model-status">

                        <span class="status-dot"></span>

                        <span>
                            Çevrimiçi
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="topbar-right">

            <span class="version-badge">
                PRO 8.00
            </span>

            <button
                class="icon-button"
                id="topSettingsButton"
                type="button"
                aria-label="Ayarlar"
            >
                ⚙
            </button>

        </div>

    </header>


    <!-- =====================================================
         SOHBET
         ===================================================== -->

    <section
        class="chat-area"
        id="chatArea"
    >

        <div
            class="chat-container"
            id="chatContainer"
        >


            <!-- WELCOME -->

            <div
                class="welcome"
                id="welcome"
            >

                <div class="welcome-logo">

                    <div class="welcome-logo-inner">
                        E
                    </div>

                </div>


                <div class="pro-welcome-badge">
                    ★ ERENCANAI PRO 8.00
                </div>


                <h1>
                    Merhaba, ben ErencanAI
                </h1>


                <p>

                    Sorularını cevaplayabilir,
                    kod yazabilir,
                    araştırabilir,
                    güncel bilgileri kontrol edebilir,
                    hava durumunu öğrenebilir
                    ve dosyalarını inceleyebilirim.

                </p>


                <!-- ÖNERİLER -->

                <div class="suggestions">


                    <button
                        class="suggestion"
                        type="button"
                        data-prompt="Bana bugün yapabileceğim güzel bir proje fikri ver."
                    >

                        <span>
                            💡
                        </span>

                        <div>

                            <strong>
                                Proje fikri
                            </strong>

                            <div>
                                Bana bir proje fikri ver
                            </div>

                        </div>

                    </button>


                    <button
                        class="suggestion"
                        type="button"
                        data-prompt="JavaScript öğrenmeme yardım et."
                    >

                        <span>
                            💻
                        </span>

                        <div>

                            <strong>
                                Kodlama
                            </strong>

                            <div>
                                Kodlama öğrenmeme yardım et
                            </div>

                        </div>

                    </button>


                    <button
                        class="suggestion"
                        type="button"
                        data-prompt="Benim için güncel bir konu araştır."
                    >

                        <span>
                            🔎
                        </span>

                        <div>

                            <strong>
                                Araştırma
                            </strong>

                            <div>
                                Güncel bir konu araştır
                            </div>

                        </div>

                    </button>


                    <button
                        class="suggestion"
                        type="button"
                        data-prompt="Bugün Konya'da hava nasıl?"
                    >

                        <span>
                            🌤️
                        </span>

                        <div>

                            <strong>
                                Hava durumu
                            </strong>

                            <div>
                                Güncel hava durumunu öğren
                            </div>

                        </div>

                    </button>


                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MESAJ GÖNDERME
         ===================================================== -->

    <div class="composer-wrapper">

        <div class="composer">


            <!-- GİRİŞ SATIRI -->

            <div class="input-row">


                <!-- DOSYA -->

                <input
                    type="file"
                    id="fileInput"
                    hidden
                    multiple
                    accept=".txt,.json,.js,.html,.css,.py,.cs,.md,.csv,.pdf,.docx,.png,.jpg,.jpeg,.webp"
                >


                <!-- ATAÇ -->

                <button
                    class="attach-button"
                    id="attachButton"
                    type="button"
                    aria-label="Dosya ekle"
                    title="Dosya ekle"
                >
                    📎
                </button>


                <!-- MESAJ -->

                <textarea
                    id="messageInput"
                    rows="1"
                    placeholder="ErencanAI'ye bir şey sor..."
                    autocomplete="off"
                ></textarea>


                <!-- GÖNDER -->

                <button
                    class="send-button"
                    id="sendButton"
                    type="button"
                    aria-label="Gönder"
                >
                    ➤
                </button>

            </div>


            <!-- SEÇİLEN DOSYALAR -->

            <div
                class="selected-files"
                id="selectedFiles"
                style="display:none;"
            ></div>


            <!-- =================================================
                 ARAŞTIR / HAVA / HAFIZA
                 ================================================= -->

            <div
                class="composer-tools"
                id="composerTools"
            >

                <div class="tool-group">


                    <!-- ARAŞTIR -->

                    <button
                        class="quick-tool-static"
                        type="button"
                        id="researchToolButton"
                        aria-label="İnternet araştırması"
                    >
                        🔎 Araştır
                    </button>


                    <!-- HAVA -->

                    <button
                        class="quick-tool-static"
                        type="button"
                        id="weatherToolButton"
                        aria-label="Hava durumu"
                    >
                        🌤️ Hava Durumu
                    </button>


                    <!-- HAFIZA -->

                    <button
                        class="quick-tool-static"
                        type="button"
                        id="memoryToolButton"
                        aria-label="Hafıza"
                    >
                        🧠 Hafıza
                    </button>


                </div>


                <div class="composer-info">

                    Enter: Gönder · Shift + Enter: Yeni satır

                </div>

            </div>


        </div>


        <div class="footer-warning">

            ErencanAI bazen hata yapabilir.
            Önemli bilgileri kontrol et.

        </div>

    </div>

</main>

</div>


<!-- =========================================================
     AYARLAR MODALI
     ========================================================= -->

<div
    class="modal"
    id="settingsModal"
>

<div class="modal-box">


    <div class="modal-header">

        <div>

            <h2>
                Ayarlar
            </h2>

            <p>
                ErencanAI ayarlarını yönet
            </p>

        </div>


        <button
            class="modal-close"
            type="button"
            data-close="settingsModal"
        >
            ×
        </button>

    </div>


    <div class="settings-list">


        <div class="setting">

            <div>

                <strong>
                    Hafıza
                </strong>

                <small>
                    Sohbet geçmişini hatırla
                </small>

            </div>


            <label class="switch">

                <input
                    type="checkbox"
                    id="memorySwitch"
                    checked
                >

                <span></span>

            </label>

        </div>


        <div class="setting">

            <div>

                <strong>
                    Animasyonlar
                </strong>

                <small>
                    Arayüz animasyonlarını kullan
                </small>

            </div>


            <label class="switch">

                <input
                    type="checkbox"
                    id="animationSwitch"
                    checked
                >

                <span></span>

            </label>

        </div>


        <div class="setting">

            <div>

                <strong>
                    Güncel bilgi araştırması
                </strong>

                <small>
                    Güncel sorularda araştırma sistemini kullan
                </small>

            </div>


            <label class="switch">

                <input
                    type="checkbox"
                    id="researchSwitch"
                    checked
                >

                <span></span>

            </label>

        </div>


        <div class="setting">

            <div>

                <strong>
                    Pro özellikleri
                </strong>

                <small>
                    ErencanAI Pro 8.00 özellikleri
                </small>

            </div>


            <span class="pro-active-badge">
                PRO
            </span>

        </div>


    </div>


    <button
        class="danger-button"
        id="deleteHistoryButton"
        type="button"
    >
        Tüm Sohbet Geçmişini Sil
    </button>

</div>

</div>


<!-- =========================================================
     GOOGLE GİRİŞ MODALI
     ========================================================= -->

<div
    class="modal"
    id="googleLoginModal"
>

<div class="modal-box small">


    <div class="modal-header">

        <div>

            <h2>
                Hesap
            </h2>

            <p>
                ErencanAI hesabına giriş yap
            </p>

        </div>


        <button
            class="modal-close"
            type="button"
            data-close="googleLoginModal"
        >
            ×
        </button>

    </div>


    <div class="google-login-area">


        <div class="google-login-logo">
            G
        </div>


        <h3>
            Google ile giriş
        </h3>


        <p>

            Hesabını bağlayarak sohbet geçmişini
            cihazların arasında kullanabilirsin.

        </p>


        <button
            class="google-login-button"
            type="button"
            id="googleLoginButton"
        >
            G Google ile devam et
        </button>


        <small class="login-note">

            Giriş sistemi daha sonra etkinleştirilebilir.

        </small>


    </div>

</div>

</div>


<!-- =========================================================
     ARAMA MODALI
     ========================================================= -->

<div
    class="modal"
    id="searchModal"
>

<div class="modal-box small">


    <div class="modal-header">

        <div>

            <h2>
                Sohbetlerde Ara
            </h2>

            <p>
                Eski konuşmalarında ara
            </p>

        </div>


        <button
            class="modal-close"
            type="button"
            data-close="searchModal"
        >
            ×
        </button>

    </div>


    <input
        id="chatSearchInput"
        type="text"
        placeholder="Sohbet ara..."
        style="
            width:100%;
            padding:12px;
            border-radius:10px;
            border:1px solid var(--border);
            background:var(--panel-2);
            color:var(--text);
            outline:none;
        "
    >


    <div
        id="searchResults"
        style="margin-top:15px;"
    ></div>


</div>

</div>


<!-- =========================================================
     TOAST
     ========================================================= -->

<div
    class="toast"
    id="toast"
></div>


<!-- =========================================================
     DOSYA MODALI
     ========================================================= -->

<div
    class="modal"
    id="fileModal"
>

<div class="modal-box small">


    <div class="modal-header">

        <div>

            <h2>
                Dosya
            </h2>

            <p>
                ErencanAI'ye dosya gönder
            </p>

        </div>


        <button
            class="modal-close"
            type="button"
            data-close="fileModal"
        >
            ×
        </button>

    </div>


    <div
        id="fileModalContent"
    ></div>


</div>

</div>


<!-- =========================================================
     APP.JS
     ========================================================= -->

<script src="/app.js"></script>


<!-- =========================================================
     GÜVENLİ BAŞLANGIÇ
     ========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* =====================================================
           GENEL DEĞİŞKENLER
           ===================================================== */

        const input =
            document.getElementById(
                "messageInput"
            );


        /* =====================================================
           ÖNERİLER
           ===================================================== */

        const suggestions =
            document.querySelectorAll(
                ".suggestion"
            );


        suggestions.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const prompt =
                            button.dataset.prompt ||
                            "";

                        if (!input) {
                            return;
                        }

                        input.value =
                            prompt;

                        input.focus();

                        input.dispatchEvent(
                            new Event(
                                "input",
                                {
                                    bubbles:
                                        true
                                }
                            )
                        );

                    }
                );

            }
        );


        /* =====================================================
           MODAL KAPATMA
           ===================================================== */

        document
            .querySelectorAll(
                "[data-close]"
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            const id =
                                button.getAttribute(
                                    "data-close"
                                );

                            const modal =
                                document.getElementById(
                                    id
                                );

                            if (modal) {

                                modal.classList.remove(
                                    "active"
                                );

                            }

                        }
                    );

                }
            );


        /* =====================================================
           MODAL DIŞINA TIKLAMA
           ===================================================== */

        document
            .querySelectorAll(
                ".modal"
            )
            .forEach(
                function (modal) {

                    modal.addEventListener(
                        "click",
                        function (event) {

                            if (
                                event.target ===
                                modal
                            ) {

                                modal.classList.remove(
                                    "active"
                                );

                            }

                        }
                    );

                }
            );


        /* =====================================================
           AYARLAR
           ===================================================== */

        const topSettings =
            document.getElementById(
                "topSettingsButton"
            );


        if (topSettings) {

            topSettings.addEventListener(
                "click",
                function () {

                    const modal =
                        document.getElementById(
                            "settingsModal"
                        );

                    if (modal) {

                        modal.classList.add(
                            "active"
                        );

                    }

                }
            );

        }


        const settingsButton =
            document.getElementById(
                "settingsButton"
            );


        if (settingsButton) {

            settingsButton.addEventListener(
                "click",
                function () {

                    const modal =
                        document.getElementById(
                            "settingsModal"
                        );

                    if (modal) {

                        modal.classList.add(
                            "active"
                        );

                    }

                }
            );

        }


        /* =====================================================
           HESAP
           ===================================================== */

        const accountButton =
            document.getElementById(
                "accountButton"
            );


        if (accountButton) {

            accountButton.addEventListener(
                "click",
                function () {

                    const modal =
                        document.getElementById(
                            "googleLoginModal"
                        );

                    if (modal) {

                        modal.classList.add(
                            "active"
                        );

                    }

                }
            );

        }


        /* =====================================================
           SOHBET ARAMA
           ===================================================== */

        const searchButton =
            document.getElementById(
                "searchButton"
            );


        if (searchButton) {

            searchButton.addEventListener(
                "click",
                function () {

                    const modal =
                        document.getElementById(
                            "searchModal"
                        );

                    if (modal) {

                        modal.classList.add(
                            "active"
                        );

                    }

                }
            );

        }


        /* =====================================================
           DOSYA ATAÇ
           ===================================================== */

        const attachButton =
            document.getElementById(
                "attachButton"
            );


        const fileInput =
            document.getElementById(
                "fileInput"
            );


        const selectedFiles =
            document.getElementById(
                "selectedFiles"
            );


        if (
            attachButton &&
            fileInput
        ) {

            attachButton.addEventListener(
                "click",
                function () {

                    fileInput.click();

                }
            );

        }


        /* =====================================================
           DOSYA SEÇİLDİ
           ===================================================== */

        if (fileInput) {

            fileInput.addEventListener(
                "change",
                function () {

                    if (
                        !selectedFiles
                    ) {
                        return;
                    }


                    selectedFiles.innerHTML =
                        "";


                    const files =
                        Array.from(
                            fileInput.files ||
                            []
                        );


                    if (
                        files.length ===
                        0
                    ) {

                        selectedFiles.style.display =
                            "none";

                        return;

                    }


                    selectedFiles.style.display =
                        "flex";


                    files.forEach(
                        function (file) {

                            const item =
                                document.createElement(
                                    "div"
                                );


                            item.className =
                                "selected-file";


                            const sizeMB =
                                (
                                    file.size /
                                    1024 /
                                    1024
                                ).toFixed(2);


                            item.textContent =
                                "📎 " +
                                file.name +
                                " (" +
                                sizeMB +
                                " MB)";


                            selectedFiles.appendChild(
                                item
                            );

                        }
                    );

                }
            );

        }


        /* =====================================================
           ARAŞTIR BUTONU
           ===================================================== */

        const researchButton =
            document.getElementById(
                "researchToolButton"
            );


        if (
            researchButton &&
            input
        ) {

            researchButton.addEventListener(
                "click",
                function () {

                    input.value =
                        "Bu konu hakkında güncel internet araştırması yap: ";


                    input.focus();


                    input.dispatchEvent(
                        new Event(
                            "input",
                            {
                                bubbles:
                                    true
                            }
                        )
                    );

                }
            );

        }


        /* =====================================================
           HAVA DURUMU BUTONU
           ===================================================== */

        const weatherButton =
            document.getElementById(
                "weatherToolButton"
            );


        if (
            weatherButton &&
            input
        ) {

            weatherButton.addEventListener(
                "click",
                function () {

                    input.value =
                        "Güncel hava durumunu araştır ve bana bildir. Konum: ";


                    input.focus();


                    input.dispatchEvent(
                        new Event(
                            "input",
                            {
                                bubbles:
                                    true
                            }
                        )
                    );

                }
            );

        }


        /* =====================================================
           HAFIZA BUTONU
           ===================================================== */

        const memoryButton =
            document.getElementById(
                "memoryToolButton"
            );


        if (
            memoryButton &&
            input
        ) {

            memoryButton.addEventListener(
                "click",
                function () {

                    input.value =
                        "Hafızamda benimle ilgili neler var?";


                    input.focus();


                    input.dispatchEvent(
                        new Event(
                            "input",
                            {
                                bubbles:
                                    true
                            }
                        )
                    );

                }
            );

        }


    }
);

</script>

</body>
</html>